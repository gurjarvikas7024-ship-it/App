<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- 1. TOP URGENCY PILL BADGE -->
        <LinearLayout
            android:id="@+id/ll_urgency_badge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#33DC2626"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_urgency_badge_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 EARLY BIRD OFFER — FIRST 1,000 USERS ONLY"
                android:textColor="#FCA5A5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/tv_urgency_badge_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Price increases to ₹1,200/yr once 1,000 seats fill up"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:textAlignment="center" />
        </LinearLayout>

        <!-- 2. LIVE SLOTS PROGRESS BAR -->
        <LinearLayout
            android:id="@+id/ll_slots_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="14dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_slots_claimed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="🔴 953 / 1,000 Claimed"
                    android:textColor="#F87171"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_slots_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Only 47 Lifetime Spots Left!"
                    android:textColor="#FBBF24"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <ProgressBar
                android:id="@+id/pb_slots"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="95"
                android:progressTint="#EF4444" />
        </LinearLayout>

        <!-- 3. PRICE ANCHOR CARD -->
        <LinearLayout
            android:id="@+id/ll_price_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Regular Price Strikethrough -->
            <TextView
                android:id="@+id/tv_regular_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Regular Price: ₹1,200 / Year"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Deal Price -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tv_deal_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹399"
                    android:textColor="#10B981"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="4dp"
                    android:text="One-Time Lifetime Access"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Save Badge -->
            <TextView
                android:id="@+id/tv_save_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#40059669"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="SAVE 85% TODAY • ZERO MONTHLY FEES"
                android:textColor="#34D399"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4. FEATURE BULLETS -->
        <LinearLayout
            android:id="@+id/ll_features_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Unlimited Voice &amp; Photo Reminders"
                android:textColor="#F1F5F9"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔 Smart Voice Alerts &amp; Notifications"
                android:textColor="#F1F5F9"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ Lifetime Free Updates &amp; No Ads"
                android:textColor="#F1F5F9"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 Instant Auto-Unlock via UPI"
                android:textColor="#F1F5F9"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 5. PRIMARY CTA BUTTON -->
        <Button
            android:id="@+id/btn_pay_upi"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#059669"
            android:text="⚡ GET LIFETIME PRO FOR ₹399"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Subtext -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🔒 100% Safe Instant Payment via BharatPe / PhonePe / GPay / Paytm"
            android:textColor="#94A3B8"
            android:textSize="11.5sp"
            android:textAlignment="center" />

        <!-- 6. SECONDARY LINK: Secret Key -->
        <Button
            android:id="@+id/btn_secret_key"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Already Paid? Enter Secret Key"
            android:textColor="#38BDF8"
            android:textSize="13.5sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
