<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- 1. TOP FOMO BADGE -->
        <LinearLayout
            android:id="@+id/ll_fomo_badge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#26DC2626"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_fomo_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 EARLY BIRD OFFER — FIRST 1,000 USERS ONLY"
                android:textColor="#FCA5A5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/tv_fomo_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="🔴 953 / 1,000 Claimed — Only 47 spots remaining at ₹399 (Regular ₹1,200/yr)"
                android:textColor="#FDE047"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textAlignment="center" />
        </LinearLayout>

        <!-- 2. QR DISPLAY CARD -->
        <LinearLayout
            android:id="@+id/ll_qr_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Clean White Frame for QR Code -->
            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="#FFFFFF"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/iv_qr_code"
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_gravity="center"
                    android:src="@drawable/qr_phonepe"
                    android:contentDescription="Scan QR Code" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_qr_instructions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Scan &amp; Pay ₹399 via Any UPI App&#10;(PhonePe / GPay / Paytm)"
                android:textColor="#F1F5F9"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:lineSpacingExtra="2dp" />

            <!-- UPI ID Bar with Copy Button -->
            <LinearLayout
                android:id="@+id/ll_upi_id_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#0F172A"
                android:padding="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_upi_id"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="UPI ID: 7024991656@ybl"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_copy_upi"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#334155"
                    android:text="Copy"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. WHATSAPP CTA BUTTON -->
        <Button
            android:id="@+id/btn_whatsapp_share"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#25D366"
            android:text="💬 Share Screenshot on WhatsApp to Get Key"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <!-- Subtext -->
        <TextView
            android:id="@+id/tv_whatsapp_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Payment ka screenshot bhejein aur 1 minute me Activation Key paayein"
            android:textColor="#94A3B8"
            android:textSize="11.5sp"
            android:textAlignment="center" />

        <!-- 4. ENTER KEY BUTTON -->
        <Button
            android:id="@+id/btn_enter_activation_key"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="🔑 Enter Activation Key"
            android:textColor="#10B981"
            android:textSize="14.5sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
