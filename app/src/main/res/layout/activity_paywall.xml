<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Top Banner / Badge -->
        <LinearLayout
            android:id="@+id/ll_offer_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#EA580C"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_offer_badge_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ UPGRADE TO LIFETIME PRO"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_lock_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:src="@android:drawable/ic_lock_idle_alarm"
            android:tint="#F59E0B"
            android:contentDescription="Upgrade Required" />

        <TextView
            android:id="@+id/tv_paywall_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Memory Plus Pro"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/tv_paywall_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Unlock unlimited natural voice reminders, custom alarms and edits forever."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:textAlignment="center"
            android:lineSpacingExtra="3dp" />

        <!-- Price Badge Card -->
        <LinearLayout
            android:id="@+id/ll_pricing_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="18dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tv_price_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹399 One-Time Payment"
                android:textColor="#10B981"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pay Once • Use Forever on this Device"
                android:textColor="#F59E0B"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Features List Card -->
        <LinearLayout
            android:id="@+id/ll_features_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Unlimited Reminders"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔 Voice Alerts &amp; Custom Sounds"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ 100% Ad-Free Lifetime Access"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Big Emerald Green CTA Button: 1-Tap UPI Launcher -->
        <Button
            android:id="@+id/btn_pay_upi"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#059669"
            android:text="⚡ Pay ₹399 &amp; Unlock Lifetime Pro"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Security / Subtext -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Supports PhonePe, Google Pay, Paytm &amp; all UPI Apps"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textAlignment="center" />

    </LinearLayout>
</ScrollView>
